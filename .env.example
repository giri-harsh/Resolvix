# Copy to .env at the repo root and fill in.

# Agora project — App ID is public/safe in the browser; App Certificate must stay server-side.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Agora ConvoAI REST (Basic auth), distinct from the RTC App ID/Certificate pair.
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# Sent as llm.api_key at ConvoAI join time; our /v1/chat/completions stub checks the
# incoming Bearer token against this so nobody else can call it for free.
AGORA_LLM_SHARED_SECRET=

# GROQ_API_KEY doubles as the answer/classifier LLM key and the TTS key.
# Model names are account-specific — check console.groq.com/settings/limits (models
# tab) before assuming these match your account. As of this pass: llama-3.1-8b-instant
# and playai-tts (the PRD's original picks) are NOT available; gpt-oss-20b and
# canopylabs/orpheus-v1-english are, but Orpheus needs its terms accepted once at
# console.groq.com/playground?model=canopylabs%2Forpheus-v1-english before it'll work.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TTS_BASE_URL=https://api.groq.com/openai/v1
TTS_MODEL=canopylabs/orpheus-v1-english
TTS_VOICE=autumn

# ASR: Deepgram, not Agora's own "ares" — verified live that ares fails outright on
# this account (confirmed via Agora console: ASR module.error_occurred, vendor: ares).
DEEPGRAM_API_KEY=
DEEPGRAM_URL=wss://api.deepgram.com/v1/listen
DEEPGRAM_MODEL=nova-3

# Public HTTPS URL this server is reachable at (ngrok tunnel, etc) so ConvoAI can reach
# {PUBLIC_BASE_URL}/v1/chat/completions from the internet.
PUBLIC_BASE_URL=http://localhost:8000

# Vobiz WhatsApp Business API (pivot v3 §7, civic_municipal's "water" queue).
# Needs a real Vobiz account + provisioned WhatsApp Business Account — get
# these from vobiz.ai, not something this build can create. Adapter no-ops
# safely (logs a warning) if any of these are unset.
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_CHANNEL_ID=
VOBIZ_WABA_ID=
