{
  "$defs": {
    "CallChannel": {
      "enum": [
        "pstn",
        "web",
        "test"
      ],
      "title": "CallChannel",
      "type": "string"
    },
    "Lang": {
      "enum": [
        "hi",
        "en",
        "hinglish"
      ],
      "title": "Lang",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "call_id": {
      "title": "Call Id",
      "type": "string"
    },
