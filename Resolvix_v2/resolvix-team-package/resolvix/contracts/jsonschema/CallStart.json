      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Caller Number"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "kb_version": {
      "title": "Kb Version",
      "type": "string"
    },
    "lang": {
      "$ref": "#/$defs/Lang",
