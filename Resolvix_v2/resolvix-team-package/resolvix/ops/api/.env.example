# Ops API Configuration

PORT=8100
DATABASE_URL=sqlite:///./data/resolvix.db
SERVICE_KEY=change-me-in-production-service-key-for-runtime
SESSION_SECRET=change-me-in-production-session-secret-32plus-chars
SEED_PASSWORD=DemoPassword123!
OPS_PUBLIC_URL=http://localhost:8100
CORS_ORIGINS=http://localhost:5173

# Runtime integration
RUNTIME_MODE=mock
RUNTIME_URL=http://localhost:8000

# Notifications
NOTIFY_MODE=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Config files (relative to ops/api directory)
DEPARTMENTS_FILE=../../contracts/config/departments.yaml
URGENCY_RULES_FILE=../../contracts/config/urgency_rules.yaml
SMS_TEMPLATES_FILE=../../contracts/config/sms_templates.yaml

# Timezone
TIMEZONE=Asia/Kolkata

# Seed users on startup
SEED_USERS_ON_STARTUP=true
